          "test": {
            "check": "contains",
            "text": "x"
          },
          "not": false
        },
        {
          "kind": "field",
          "fieldId": "b",
          "test": {
            "check": "equals",
            "text": "y"
          },
          "not": false
        },
        {
          "kind": "field",
          "fieldId": "c",
          "test": {
            "check": "number",
            "cmp": ">=",
            "value": 2.5
          },
          "not": false
        },
        {
          "kind": "field",
          "fieldId": "d",
          "test": {
            "check": "between",
            "min": 1,
            "max": 9
          },
          "not": true
        },
        {
          "kind": "field",
          "fieldId": "e",
          "test": {
            "check": "choice",
            "optionIds": [
              "x",
              "y"
            ]
          },
          "not": false
        },
        {
          "kind": "field",
          "fieldId": "f",
          "test": {
            "check": "links",
            "itemId": "i3"
          },
          "not": false
        },
        {
          "kind": "field",
          "fieldId": "g",
          "test": {
            "check": "empty"
          },
          "not": true
        }
      ]
    },
    "sort": [
      {
        "by": "name",
        "dir": "asc"
      }
